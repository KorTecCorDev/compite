{
    "name": "compite/cociap2026",
    "description": "Sistema de inscripciones — IV Concurso Regional de Conocimientos COCIAP 2026",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "phpoffice/phpspreadsheet": "^2.3",
        "dompdf/dompdf": "^3.0",
        "endroid/qr-code": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"echo PHP_EOL, 'Recuerda: el codigo corre sobre el PHP de XAMPP (8.2.12), no sobre el de Composer.', PHP_EOL;\""
        ]
    }
}
